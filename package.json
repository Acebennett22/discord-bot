{
  "name": "ace-discord-bot",
  "version": "1.14.12",
  "description": "Multi-file Discord bot for Ace \u2014 moderation, music, server status/monitoring, and fun/games. Built with discord.js v14 (CommonJS).",
  "main": "index.js",
  "scripts": {
    "start": "node src/shardManager.js",
    "dev": "node --watch index.js",
    "deploy": "node src/deploy-commands.js",
    "start:unsharded": "node index.js",
    "dashboard": "node src/dashboard.js",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "discord.js": "^14.22.1",
    "play-dl": "^1.9.7",
    "mysql2": "^3.11.0",
    "axios": "^1.7.0",
    "canvas": "^3.2.3",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "node-cron": "^3.0.3"
  }
}
