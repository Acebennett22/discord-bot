{
  "name": "ace-discord-bot",
  "version": "1.16.20",
  "description": "Multi-file Discord bot for Ace — moderation, music, server status/monitoring, and fun/games. Built with discord.js v14 (CommonJS).",
  "main": "index.js",
  "scripts": {
    "start": "node src/shardManager.js",
    "dev": "node --watch index.js",
    "deploy": "node src/deploy-commands.js",
    "start:unsharded": "node index.js",
    "dashboard": "node src/dashboard.js",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@distube/ytdl-core": "^5.2.1",
    "axios": "^1.7.0",
    "canvas": "^3.2.3",
    "discord.js": "^14.22.1",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.11.0",
    "node-cron": "^4.6.0"
  }
}
