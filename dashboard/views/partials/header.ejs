<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><title>Vikings Hall Dashboard</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/style.css"><script src="/app.js" defer></script></head>
<body>
<header>
  <div class="brand-wrap"><a class="brand" href="/servers">🤖 Vikings Hall Dashboard</a><a class="btn btn-sm" href="/invite" target="_blank" rel="noopener">➕ Add to Server</a></div>
  <div class="header-right">
    <% if (typeof isStaff !== 'undefined' && isStaff) { %><a href="/staff">Staff</a><% } %>
    <a href="/docs">Wiki</a>
    <a href="/version">Version</a>
    <% if (typeof localAccount !== 'undefined' && localAccount) { %><span class="user-chip"><span class="user-avatar user-avatar-fallback"><%= localAccount.username ? localAccount.username.charAt(0).toUpperCase() : '?' %></span><span class="user"><%= localAccount.username %></span><span class="muted"> · <%= localAccount.role %></span></span> <a href="/logout">Logout</a><% } else if (typeof user !== 'undefined' && user) { %><span class="user-chip"><% if (user.avatar && user.id) { %><img class="user-avatar" src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex'"><span class="user-avatar user-avatar-fallback" style="display:none"><%= user.username ? user.username.charAt(0).toUpperCase() : '?' %></span><% } else { %><span class="user-avatar user-avatar-fallback"><%= user.username ? user.username.charAt(0).toUpperCase() : '?' %></span><% } %><span class="user"><%= user.username %></span></span> <a href="/logout">Logout</a><% } else { %><a href="/login">Login</a><% } %>
  </div>
</header>
<main>
