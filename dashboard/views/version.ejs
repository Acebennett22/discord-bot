<%- include('partials/header') %>
<section class="hero">
  <h1>Vikings Hall — v<%= version %></h1>
  <p>Changelog, rendered from <code>CHANGELOG.md</code>. The version above always comes from <code>package.json</code>; every entry below comes from the changelog file. New to the bot? Start with the <a href="/docs">wiki</a>.</p>
  <div class="actions">
    <a class="btn" href="/login">Login with Discord</a>
    <a class="btn ghost" href="/invite" target="_blank" rel="noopener">➕ Add to Server</a>
  </div>
</section>

<% if (!entries.length) { %>
  <p class="muted">No changelog entries found — <code>CHANGELOG.md</code> is missing or empty.</p>
<% } %>
<% entries.forEach(e => { %>
  <div class="card" style="text-align:left;margin-bottom:16px">
    <h2 style="margin-top:0">v<%= e.version %> <span class="muted" style="font-size:14px">— <%= e.date %><%= e.version === version ? ' · current version' : '' %></span></h2>
    <% if (!e.sections.length) { %><p class="muted">No changes listed for this version.</p><% } %>
    <% e.sections.forEach(s => { %>
      <h3><%= s.title %></h3>
      <ul>
        <% s.items.forEach(item => { %><li><%= item %></li><% }); %>
      </ul>
    <% }); %>
  </div>
<% }); %>
<%- include('partials/footer') %>
