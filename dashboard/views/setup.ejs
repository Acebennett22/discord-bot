<%- include('partials/header') %>
<div class="settings-layout">
  <aside class="sidebar">
    <div class="server-head"><img src="/favicon.svg" alt=""><strong>First-run setup</strong></div>
    <nav>
      <% steps.forEach(s => { %>
        <a href="/setup/<%= s.n %>" class="<%= s.n === step.n ? 'active' : '' %>"><%= s.n %>. <%= s.title %><%= s.optional ? ' (optional)' : '' %></a>
      <% }); %>
    </nav>
    <p class="muted" style="margin-top:14px">Setup writes <code>config.json</code> only. Nothing is uploaded anywhere.</p>
  </aside>
  <section class="settings-content">
    <% if (typeof isHttp !== 'undefined' && isHttp) { %><div class="toast" style="background:rgba(250,166,26,.12);border-color:rgba(250,166,26,.5);color:#faa61a">⚠️ You are setting up over plain HTTP — your bot token and passwords will travel unencrypted. Serve the dashboard over HTTPS in production (see README → Nginx deployment).</div><% } %>
    <% if (error) { %><div class="toast" style="background:rgba(237,66,69,.12);border-color:rgba(237,66,69,.45);color:#ff6b6e">❌ <%= error %></div><% } %>

    <% if (saved) { %>
      <h1>✅ Setup complete!</h1>
      <p>Your config is saved<% if (botUsername) { %> and the bot connected as <strong><%= botUsername %></strong><% } %>. The wizard is now disabled (config.json has <code>setupComplete: true</code>).</p>
      <h2>Start the bot</h2>
      <p>Run these in the project folder:</p>
      <p><code>npm run deploy</code> — register the slash commands<br>
      <code>npm start</code> — start the bot (sharded)<br>
      <code>npm run dashboard</code> — start this dashboard (in another terminal)</p>
      <p><a class="btn" href="/">Go to the dashboard</a></p>
    <% } else if (finish) { %>
      <h1>Review &amp; finish</h1>
      <p class="muted">Check everything below. Secrets are masked — they are saved exactly as entered.</p>
      <table>
        <tr><th>Setting</th><th>Value</th></tr>
        <tr><td>Bot token</td><td><%= data.token ? '••••' + String(data.token).slice(-4) : '—' %></td></tr>
        <tr><td>Client ID</td><td><%= data.clientId || '—' %></td></tr>
        <tr><td>Client secret</td><td><%= data.clientSecret ? '••••' + String(data.clientSecret).slice(-4) : '—' %></td></tr>
        <tr><td>Owner ID</td><td><%= data.ownerId || '—' %></td></tr>
        <tr><td>Database</td><td><%= data.dbUser || '—' %>@<%= data.dbHost || 'localhost' %>:<%= data.dbPort || 3306 %>/<%= data.dbName || '—' %></td></tr>
        <tr><td>Dashboard port</td><td><%= data.port || 3010 %></td></tr>
        <tr><td>Redirect URI</td><td><%= data.redirectUri || '—' %></td></tr>
        <tr><td>Twitch</td><td><%= data.twitchClientId ? 'configured' : 'skipped' %></td></tr>
        <tr><td>YouTube API key</td><td><%= data.youtubeApiKey ? 'configured' : 'skipped' %></td></tr>
        <tr><td>Steam API key</td><td><%= data.steamApiKey ? 'configured' : 'skipped' %></td></tr>
        <tr><td>Backup time / retention</td><td><%= data.backupTime || '03:00' %> · <%= data.retentionDays || 30 %> days</td></tr>
        <tr><td>Embed color / max queue</td><td><%= data.embedColor || '#5865F2' %> · <%= data.maxQueueSize || 25 %></td></tr>
        <tr><td>Sharding</td><td><%= data.shardingMode || 'auto' %></td></tr>
      </table>
      <br>
      <form method="post" action="/setup/finish">
        <a class="btn ghost" href="/setup/1">← Back to edit</a>
        <button class="btn green" type="submit">💾 Save config &amp; finish</button>
      </form>
    <% } else if (step.id === 'welcome') { %>
      <h1>Welcome to Ace Bot 👋</h1>
      <p>This wizard walks you through every setting in <code>config.json</code> — no manual file editing needed. You'll need:</p>
      <ul>
        <li>A Discord application (bot token + client ID) — <a href="https://discord.com/developers/applications" target="_blank" rel="noopener">Discord Developer Portal</a></li>
        <li>A MySQL database (the wizard can create the tables for you)</li>
        <li>Optionally: Twitch, YouTube, and Steam API keys (all skippable)</li>
      </ul>
      <p class="muted">Your answers are kept in this browser session only until you hit Save on the last step. Passwords and tokens are never shown back in full and never logged.</p>
      <a class="btn" href="/setup/2">Get started →</a>
    <% } else if (step.id === 'discord') { %>
      <h1>Discord</h1>
      <p class="muted">Get these at <a href="<%= links.discordBotToken_clientId_clientSecret ? links.discordBotToken_clientId_clientSecret.split(' — ')[0] : 'https://discord.com/developers/applications' %>" target="_blank" rel="noopener">discord.com/developers/applications</a> — create an application, copy the Bot Token (Bot tab) and the Client ID + Client Secret (OAuth2 tab).</p>
      <form method="post" action="/setup/2">
        <label>Bot token *</label>
        <input type="password" name="token" value="<%= data.token || '' %>" required autocomplete="off" placeholder="Paste your bot token">
        <label>Client ID *</label>
        <input type="text" name="clientId" value="<%= data.clientId || '' %>" required placeholder="Application / client ID">
        <label>Client secret (for dashboard login)</label>
        <input type="password" name="clientSecret" value="<%= data.clientSecret || '' %>" autocomplete="off" placeholder="OAuth2 client secret">
        <label>Owner ID (your Discord user ID — enables owner commands)</label>
        <input type="text" name="ownerId" value="<%= data.ownerId || '' %>" placeholder="e.g. 123456789012345678">
        <br><br>
        <button type="button" class="btn ghost" id="test-discord">Test connection</button>
        <span id="test-discord-result" class="muted"></span>
        <br><br>
        <button class="btn" type="submit">Next →</button>
      </form>

    <% } else if (step.id === 'database') { %>
      <h1>Database (MySQL)</h1>
      <p class="muted">The bot stores logs, stats, tickets, leveling, and settings in MySQL. It keeps running without a database, but most features need it.</p>
      <form method="post" action="/setup/3">
        <label>Host</label>
        <input type="text" name="dbHost" value="<%= data.dbHost || 'localhost' %>">
        <label>Port</label>
        <input type="number" name="dbPort" value="<%= data.dbPort || 3306 %>">
        <label>Username</label>
        <input type="text" name="dbUser" value="<%= data.dbUser || 'discord_bot' %>">
        <label>Password</label>
        <input type="password" name="dbPassword" value="<%= data.dbPassword || '' %>" autocomplete="off">
        <label>Database name</label>
        <input type="text" name="dbName" value="<%= data.dbName || 'discord_bot' %>">
        <label class="toggle"><input type="checkbox" name="autoRunSchema" checked><span class="track"></span><span>Run sql/schema.sql now (create all tables)</span></label>
        <br>
        <button type="button" class="btn ghost" id="test-db">Test connection</button>
        <span id="test-db-result" class="muted"></span>
        <br><br>
        <a class="btn ghost" href="/setup/2">← Back</a>
        <button class="btn" type="submit">Next →</button>
      </form>

    <% } else if (step.id === 'dashboard') { %>
      <h1>Dashboard</h1>
      <p class="muted">The web GUI (Dyno-style) — Discord OAuth2 login, per-server settings.</p>
      <form method="post" action="/setup/4">
        <label>Port</label>
        <input type="number" name="port" id="dash-port" value="<%= data.port || 3010 %>">
        <label>Session secret</label>
        <input type="text" name="sessionSecret" id="session-secret" value="<%= data.sessionSecret || '' %>" placeholder="Click generate">
        <button type="button" class="btn ghost" id="gen-secret">Generate random secret</button>
        <label>Redirect URI (must match the OAuth2 redirect in the Developer Portal)</label>
        <input type="text" name="redirectUri" id="redirect-uri" value="<%= data.redirectUri || (typeof publicUrl !== 'undefined' && publicUrl ? publicUrl + '/callback' : 'http://localhost:3010/callback') %>">
        <br><br>
        <a class="btn ghost" href="/setup/3">← Back</a>
        <button class="btn" type="submit">Next →</button>
      </form>

    <% } else if (step.id === 'streaming') { %>
      <h1>Streaming APIs <span class="muted">(optional)</span></h1>
      <p class="muted">Needed only for live stream notifications. Skip this step if you don't use them — you can fill them in later in config.json.</p>
      <form method="post" action="/setup/5">
        <label>Twitch client ID — <a href="https://dev.twitch.tv/console" target="_blank" rel="noopener">dev.twitch.tv/console</a></label>
        <input type="text" name="twitchClientId" value="<%= data.twitchClientId || '' %>">
        <label>Twitch client secret</label>
        <input type="password" name="twitchClientSecret" value="<%= data.twitchClientSecret || '' %>" autocomplete="off">
        <label>YouTube Data API v3 key — <a href="https://console.cloud.google.com/apis/library/youtube.googleapis.com" target="_blank" rel="noopener">Google Cloud Console</a></label>
        <input type="password" name="youtubeApiKey" value="<%= data.youtubeApiKey || '' %>" autocomplete="off">
        <br><br>
        <a class="btn ghost" href="/setup/4">← Back</a>
        <button class="btn" type="submit">Next →</button>
      </form>
    <% } else if (step.id === 'steam') { %>
      <h1>Steam API <span class="muted">(optional)</span></h1>
      <p class="muted">Needed only for /steam and /linksteam. Get a free key at <a href="https://steamcommunity.com/dev/apikey" target="_blank" rel="noopener">steamcommunity.com/dev/apikey</a>.</p>
      <form method="post" action="/setup/6">
        <label>Steam Web API key</label>
        <input type="password" name="steamApiKey" value="<%= data.steamApiKey || '' %>" autocomplete="off">
        <br><br>
        <a class="btn ghost" href="/setup/5">← Back</a>
        <button class="btn" type="submit">Next →</button>
      </form>
    <% } else if (step.id === 'misc') { %>
      <h1>Backups &amp; misc</h1>
      <form method="post" action="/setup/7">
        <label>Daily backup time (24h, e.g. 03:00)</label>
        <input type="text" name="backupTime" value="<%= data.backupTime || '03:00' %>">
        <label>Backup retention (days)</label>
        <input type="number" name="retentionDays" min="1" max="365" value="<%= data.retentionDays || 30 %>">
        <label>Embed color</label>
        <input type="text" name="embedColor" value="<%= data.embedColor || '#5865F2' %>">
        <label>Music max queue size</label>
        <input type="number" name="maxQueueSize" min="1" max="100" value="<%= data.maxQueueSize || 25 %>">
        <label>Sharding mode</label>
        <select name="shardingMode">
          <option value="auto" <%= (data.shardingMode || 'auto') === 'auto' ? 'selected' : '' %>>auto (Discord recommends ~1 shard per 1,000 guilds)</option>
          <option value="manual" <%= data.shardingMode === 'manual' ? 'selected' : '' %>>manual (set totalShards in config.json)</option>
        </select>
        <br><br>
        <a class="btn ghost" href="/setup/6">← Back</a>
        <button class="btn" type="submit">Review →</button>
      </form>
    <% } %>
  </section>
</div>
<script>window.ACEBOT_PAGE = { page: 'setup' };</script>
<script src="/js/setup.js" defer></script>
<%- include('partials/footer') %>
