<%- include('partials/header') %>
<div class="settings-layout">
  <aside class="sidebar">
    <div class="server-head">
      <% if (guild.icon) { %><img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt=""><% } else { %><img src="/favicon.svg" alt=""><% } %>
      <strong><%= guild.name %></strong>
    </div>
    <nav>
      <% const MODS = [['general','⚙️ General'],['moderation','🛡️ Moderation'],['tickets','🎫 Tickets'],['serverstats','📊 Server Stats'],['streams','📺 Streams'],['music','🎵 Music'],['leveling','🏆 Leveling'],['reactionroles','🎭 Reaction Roles'],['gameservers','🖥️ Game Servers'],['applications','📝 Applications'],['commands','⌨️ Commands'],['invites','📨 Invites'],['welcome','👋 Welcome'],['automod','🤖 Automod'],['suggestions','💡 Suggestions'],['economy','🪙 Economy'],['starboard','⭐ Starboard'],['customcommands','⌨️ Custom Commands'],['faq','💬 FAQ'],['scheduled','⏰ Scheduled'],['roles','🎭 Roles']]; %>
      <% MODS.forEach(([m, label]) => { %>
        <a href="/guilds/<%= guild.id %>/<%= m %>" class="<%= module === m ? 'active' : '' %>"><%= label %></a>
      <% }); %>
    </nav>
  </aside>
  <section class="settings-content">
    <% if (saved) { %><div class="toast">✅ Settings saved.</div><% } %>

    <% if (module === 'general') { %>
    <h1>General settings</h1>
    <p class="muted">Welcome messages, logs, and the bot's look in this server.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/settings">
      <label>Welcome channel</label>
      <select name="welcomeChannelId"><option value="">— none —</option>
        <% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= settings.welcomeChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %>
      </select>
      <label>Mod log channel</label>
      <select name="logChannelId"><option value="">— none —</option>
        <% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= settings.logChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %>
      </select>
      <label>Embed color</label>
      <input type="text" name="embedColor" value="<%= settings.embedColor || '' %>" placeholder="#5865F2">
      <br><br><button class="btn" type="submit">Save general settings</button>
    </form>
    <% } %>

    <% if (module === 'moderation') { %>
    <h1>Moderation</h1>
    <p class="muted">Warn thresholds and automatic actions.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/settings">
      <label>Warn threshold (warns before auto-action, 0 = off)</label>
      <input type="number" name="warnThreshold" min="0" max="100" value="<%= settings.warnThreshold ?? '' %>">
      <label>Auto-action at threshold</label>
      <select name="warnAction">
        <option value="">— none —</option>
        <option value="timeout" <%= settings.warnAction === 'timeout' ? 'selected' : '' %>>Timeout 10 min</option>
        <option value="kick" <%= settings.warnAction === 'kick' ? 'selected' : '' %>>Kick</option>
        <option value="ban" <%= settings.warnAction === 'ban' ? 'selected' : '' %>>Ban</option>
      </select>
      <br><br><button class="btn" type="submit">Save moderation settings</button>
    </form>
    <h2>Message logging (modlog)</h2>
    <p class="muted">Deleted and edited messages are stored in MySQL and posted here. Content that looks like a token or password is redacted before it is stored. Same channel as /modlog-setup in Discord.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/premium">
      <label>Modlog channel</label>
      <select name="modlogChannelId"><option value="">— off —</option>
        <% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= premiumSettings?.modlogChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %>
      </select>
      <br><br><button class="btn" type="submit">Save modlog channel</button>
    </form>
    <% } %>

    <% if (module === 'tickets') { %>
    <h1>Tickets</h1>
    <p class="muted">Where tickets live and who can work them.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/settings">
      <label>Ticket category</label>
      <select name="ticketCategoryId"><option value="">— none —</option>
        <% channels.filter(c => c.type === 4).forEach(c => { %><option value="<%= c.id %>" <%= settings.ticketCategoryId === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
      </select>
      <label>Ticket support role</label>
      <select name="ticketSupportRoleId"><option value="">— none —</option>
        <% roles.forEach(r => { %><option value="<%= r.id %>" <%= settings.ticketSupportRoleId === r.id ? 'selected' : '' %>><%= r.name %></option><% }); %>
      </select>
      <label>Ticket log channel</label>
      <select name="ticketLogChannelId"><option value="">— none —</option>
        <% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= settings.ticketLogChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %>
      </select>
      <br><br><button class="btn" type="submit">Save ticket settings</button>
    </form>
    <h3>Recent tickets</h3>
    <% if (!tickets.length) { %><p>No tickets yet.</p><% } %>
    <ul><% tickets.forEach(t => { %><li>#<%= t.id %> — <%= t.subject || '—' %> — <%= t.status %> — &lt;@<%= t.user_id %>&gt;</li><% }); %></ul>
    <% } %>

    <% if (module === 'serverstats') { %>
    <h1>Server Stats</h1>
    <p class="muted">Live stat channels, like the ServerStats bot.</p>
    <p>Server Stats are <%= settings.serverStatsEnabled ? '✅ enabled' : '❌ disabled' %> in this server.</p>
    <p>Enabled channels: <%= Object.keys(settings.serverStatsChannels || {}).join(', ') || 'none' %></p>
    <form method="post" action="/api/guilds/<%= guild.id %>/settings">
      <label class="toggle"><input type="checkbox" name="serverStatsEnabled" value="true" <%= settings.serverStatsEnabled ? 'checked' : '' %>><span class="track"></span><span>Server stats enabled</span></label>
      <br><button class="btn" type="submit">Save</button>
    </form>
    <p class="muted">Use <code>/serverstats-setup</code> and <code>/serverstats-toggle</code> in Discord to manage individual stat channels.</p>
    <% } %>

    <% if (module === 'streams') { %>
    <h1>Streams</h1>
    <p class="muted">Watched streamers, live alerts, and the live-channel name. Discord commands (/stream-add, /stream-remove, /stream-list) use the same table — dashboard and Discord stay in sync.</p>

    <h2>Live channel name template</h2>
    <p class="muted">Used when a streamer's live channel is renamed while they stream. Placeholders: <code>{name}</code> (required), <code>{game}</code>, <code>{title}</code>. Max 100 characters, one line. Stored in the database (guild_settings) — the same field /stream-template edits in Discord.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/settings" id="template-form">
      <input type="text" name="liveChannelNameTemplate" id="template-input" value="<%= settings.liveChannelNameTemplate || '' %>" placeholder="🔴 LIVE: {name}" maxlength="100">
      <p class="muted">Preview: <code id="template-preview"></code></p>
      <button class="btn" type="submit">Save template</button>
    </form>

    <h2>Watched streamers <button class="btn ghost" type="button" data-refresh-section="#streamers-list">🔄 Refresh</button></h2>
    <div id="streamers-list">
    <% if (!streamers.length) { %><p class="muted">None yet — add one below.</p><% } %>
    <table><tr><th></th><th>Streamer</th><th>Platform</th><th>Announcements</th><th>Ping role</th><th>Live channel</th><th></th></tr>
    <% streamers.forEach(s => { %>
      <tr>
        <td><%= s.is_live ? '🔴' : '⚫' %></td>
        <td><strong><%= s.channel_id_or_name %></strong></td>
        <td><%= s.platform %></td>
        <td><%= s.notify_channel_id ? '#' + (channels.find(c => c.id === s.notify_channel_id)?.name || s.notify_channel_id) : '—' %></td>
        <td><%= s.ping_role_id ? '@' + (roles.find(r => r.id === s.ping_role_id)?.name || s.ping_role_id) : '—' %></td>
        <td><%= s.live_channel_id ? '#' + (channels.find(c => c.id === s.live_channel_id)?.name || s.live_channel_id) : 'none' %></td>
        <td>
          <button class="btn ghost" data-refresh-streamer="<%= s.id %>">Refresh</button>
          <button class="btn ghost" data-edit-streamer="<%= s.id %>">Edit</button>
          <button class="btn danger" data-remove-streamer="<%= s.id %>">Remove</button>
        </td>
      </tr>
      <tr id="edit-row-<%= s.id %>" style="display:none"><td colspan="7">
        <form class="edit-streamer-form" data-streamer-id="<%= s.id %>">
          <label>Notify channel</label>
          <select name="notifyChannelId"><% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= s.notify_channel_id === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %></select>
          <label>Ping role (optional)</label>
          <select name="pingRoleId"><option value="">— none —</option><% roles.forEach(r => { %><option value="<%= r.id %>" <%= s.ping_role_id === r.id ? 'selected' : '' %>><%= r.name %></option><% }); %></select>
          <label>Live channel (optional — renames while live)</label>
          <select name="liveChannelId"><option value="">— none —</option><% channels.filter(c => c.type === 0 || c.type === 2).forEach(c => { %><option value="<%= c.id %>" <%= s.live_channel_id === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %></select>
          <br><br><button class="btn" type="submit">Save changes</button>
        </form>
      </td></tr>
    <% }); %></table>
    </div>

    <h2>Add a streamer</h2>
    <form id="add-streamer-form">
      <label>Platform</label>
      <select name="platform">
        <option value="twitch">Twitch</option><option value="youtube">YouTube</option><option value="kick">Kick</option>
        <option value="facebook">Facebook (manual announcements only)</option><option value="tiktok">TikTok (manual announcements only)</option>
      </select>
      <label>Channel name / URL</label>
      <input type="text" name="channel" placeholder="Twitch login, YouTube channel ID, Kick slug…" required>
      <label>Notify channel</label>
      <select name="notifyChannelId"><% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>">#<%= c.name %></option><% }); %></select>
      <label>Ping role (optional)</label>
      <select name="pingRoleId"><option value="">— none —</option><% roles.forEach(r => { %><option value="<%= r.id %>"><%= r.name %></option><% }); %></select>
      <label>Live channel (optional)</label>
      <select name="liveChannelId"><option value="">— none —</option><% channels.filter(c => c.type === 0 || c.type === 2).forEach(c => { %><option value="<%= c.id %>">#<%= c.name %></option><% }); %></select>
      <br><br><button class="btn" type="submit">Add streamer</button>
    </form>
    <p id="streamer-result" class="muted"></p>
    <% } %>

    <% if (module === 'music') { %>
    <h1>Music</h1>
    <p class="muted">Who can control the music.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/settings">
      <label>DJ role (only this role + admins can use music commands)</label>
      <select name="djRoleId"><option value="">— none (everyone) —</option>
        <% roles.forEach(r => { %><option value="<%= r.id %>" <%= settings.djRoleId === r.id ? 'selected' : '' %>><%= r.name %></option><% }); %>
      </select>
      <br><br><button class="btn" type="submit">Save music settings</button>
    </form>
    <p class="muted">Max queue size is set in config.json (<code>music.maxQueueSize</code>) and applies to all servers.</p>
    <% } %>

    <% if (module === 'leveling') { %>
    <h1>Leveling</h1>
    <p class="muted">XP rewards and level-up role rewards.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/settings">
      <label class="toggle"><input type="checkbox" name="levelUpMessages" value="true" <%= settings.levelUpMessages ? 'checked' : '' %>><span class="track"></span><span>Send level-up messages in-channel</span></label>
      <label>Level role rewards (JSON: {"5": "roleId", "10": "roleId"})</label>
      <input type="text" name="levelRoles" value='<%= JSON.stringify(settings.levelRoles || {}) %>'>
      <br><br><button class="btn" type="submit">Save leveling settings</button>
    </form>
    <% } %>

    <% if (module === 'reactionroles') { %>
    <h1>Reaction Roles</h1>
    <p class="muted">Reaction roles are managed with <code>/reactionroles-setup</code>, <code>/reactionroles-add</code>, <code>/reactionroles-remove</code> and <code>/reactionroles-list</code> in Discord. Mappings live in the <code>reaction_roles</code> MySQL table.</p>
    <% } %>

    <% if (module === 'commands') { %>
    <h1>Commands</h1>
    <p class="muted">Enable or disable commands in this server. A command disabled globally by staff can't be re-enabled here.</p>
    <div id="commands-list"><p class="muted">Loading…</p></div>
    <% } %>

    <% if (module === 'applications') { %>
    <h1>Applications</h1>
    <p class="muted">Appy-style application forms. Members apply with /apply; submissions land in the review channel and here, in the review queue.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/settings">
      <label>Application reviewer role (can review besides admins)</label>
      <select name="applicationReviewerRoleId"><option value="">— admins only —</option>
        <% roles.forEach(r => { %><option value="<%= r.id %>" <%= settings.applicationReviewerRoleId === r.id ? 'selected' : '' %>><%= r.name %></option><% }); %>
      </select>
      <br><br><button class="btn" type="submit">Save reviewer role</button>
    </form>
    <h2>Forms <button class="btn ghost" type="button" data-refresh-section="#app-forms-list">🔄 Refresh</button></h2>
    <div id="app-forms-list">
    <% if (!applicationForms.length) { %><p class="muted">No forms yet.</p><% } %>
    <table><tr><th>ID</th><th>Name</th><th>Status</th><th>Pending</th><th>Total</th><th>Review channel</th><th>Role on accept</th><th></th></tr>
    <% applicationForms.forEach(f => { %>
      <tr><td>#<%= f.id %></td><td><strong><%= f.name %></strong></td><td><%= f.is_open ? '🟢 open' : '🔴 closed' %></td>
      <td><%= f.pending_count %></td><td><%= f.total_count %></td>
      <td>#<%= (channels.find(c => c.id === f.review_channel_id)?.name || f.review_channel_id) %></td>
      <td><%= f.role_to_grant ? '@' + (roles.find(r => r.id === f.role_to_grant)?.name || f.role_to_grant) : '—' %></td>
      <td><button class="btn ghost" data-app-form-toggle="<%= f.id %>" data-app-form-open="<%= f.is_open ? 0 : 1 %>"><%= f.is_open ? 'Close' : 'Open' %></button></td></tr>
    <% }); %></table>
    </div>
    <h2>Create a form</h2>
    <form id="create-app-form">
      <label>Name</label>
      <input type="text" name="name" required maxlength="128" placeholder="e.g. Staff Application">
      <label>Description</label>
      <input type="text" name="description" placeholder="What is this application for?">
      <label>Questions (one per line, max 5)</label>
      <textarea name="questions" rows="5" required placeholder="Why do you want to join?&#10;How much experience do you have?"></textarea>
      <label>Role granted on accept (optional)</label>
      <select name="roleToGrant"><option value="">— none —</option><% roles.forEach(r => { %><option value="<%= r.id %>"><%= r.name %></option><% }); %></select>
      <label>Review channel</label>
      <select name="reviewChannelId"><% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>">#<%= c.name %></option><% }); %></select>
      <br><br><button class="btn" type="submit">Create form</button>
    </form>
    <p id="app-form-result" class="muted"></p>
    <h2>Review queue (pending) <button class="btn ghost" type="button" data-refresh-section="#app-queue-list">🔄 Refresh</button></h2>
    <div id="app-queue-list">
    <% if (!pendingApplications.length) { %><p class="muted">Nothing pending. 🎉</p><% } %>
    <% pendingApplications.forEach(a => { %>
      <div class="card" style="text-align:left;margin-bottom:12px">
        <strong>#<%= a.id %> — <%= a.form_name %></strong> · <code>&lt;@<%= a.user_id %>&gt;</code><br>
        <% try { const ans = JSON.parse(a.answers); ans.forEach((x, i) => { %><p><strong>Q<%= i + 1 %>:</strong> <%= x %></p><% }); } catch {} %>
        <input type="text" placeholder="Review note (optional)" id="note-<%= a.id %>">
        <br><br>
        <button class="btn green" data-app-review="<%= a.id %>" data-app-decision="accepted">✅ Accept</button>
        <button class="btn danger" data-app-review="<%= a.id %>" data-app-decision="denied">❌ Deny</button>
      </div>
    <% }); %>
    </div>
    <% } %>

    <% if (module === 'invites') { %>
    <h1>Invites</h1>
    <p class="muted">Invite tracking: on every join the bot compares its cached invite uses to the live list to find the inviter. Joins from accounts younger than the fake threshold are flagged fake and don't count as valid. Vanity URL joins are counted separately.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/settings">
      <label>Invite log channel (defaults to the welcome channel if unset)</label>
      <select name="inviteLogChannelId"><option value="">— use welcome channel —</option>
        <% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= settings.inviteLogChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %>
      </select>
      <label>Fake-account age threshold (days) — accounts younger than this are flagged fake</label>
      <input type="number" name="inviteMinAccountAgeDays" min="0" max="365" value="<%= settings.inviteMinAccountAgeDays ?? 7 %>">
      <br><br><button class="btn" type="submit">Save invite settings</button>
    </form>
    <p class="muted">The bot needs Manage Server permission to fetch the invite list — without it, joins show as "unknown invite".</p>
    <h2>Leaderboard <button class="btn ghost" type="button" data-refresh-section="#invites-list">🔄 Refresh</button></h2>
    <div id="invites-list">
    <% if (!inviteLeaderboard.length) { %><p class="muted">No invites tracked yet.</p><% } %>
    <table><tr><th>#</th><th>User</th><th>Valid</th><th>Total</th><th>Leaves</th><th>Fake</th></tr>
    <% inviteLeaderboard.forEach((r, i) => { %><tr><td><%= i + 1 %></td><td>&lt;@<%= r.user_id %>&gt;</td><td><strong><%= r.valid_invites %></strong></td><td><%= r.total_invites %></td><td><%= r.leaves %></td><td><%= r.fake_invites %></td></tr><% }); %></table>
    <h2>Per-user stats</h2>
    <table><tr><th>User</th><th>Valid</th><th>Total</th><th>Leaves</th><th>Fake</th><th>Updated</th></tr>
    <% inviteStats.forEach(r => { %><tr><td>&lt;@<%= r.user_id %>&gt;</td><td><%= r.valid_invites %></td><td><%= r.total_invites %></td><td><%= r.leaves %></td><td><%= r.fake_invites %></td><td><%= r.updated_at %></td></tr><% }); %></table>
    </div>
    <% } %>

    <% if (module === 'gameservers') { %>
    <h1>Game Servers</h1>
    <p class="muted">Tracked game servers for this guild.</p>
    <% if (!gameServers.length) { %><p>None tracked in this server yet — add one with /gameserver-add in Discord.</p><% } %>
    <ul><% gameServers.forEach(s => { %><li><strong><%= s.name %></strong> — <%= s.provider %> · <%= s.host %><% if (s.port) { %>:<%= s.port %><% } %></li><% }); %></ul>
    <p class="muted">Config-level examples (Minecraft, Rust, The Isle) live in config.json <code>gameServers.custom</code>. The Isle has no public query protocol — it is manual status only.</p>
    <% } %>

    <% if (module === 'economy') { %>
    <h1>Economy</h1>
    <p class="muted">Server currency: /daily, /work, /pay, /balance, wallet vs bank, and the shop. Amounts below are the per-server settings — global defaults live in config.json <code>economy</code>.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/premium">
      <label>Starting balance (coins a new user starts with)</label>
      <input type="number" name="economyStartingBalance" min="0" max="100000" value="<%= premiumSettings?.economyStartingBalance ?? 100 %>">
      <label>Daily reward — min / max coins</label>
      <input type="number" name="economyDailyMin" min="0" max="100000" value="<%= premiumSettings?.economyDailyMin ?? 100 %>">
      <input type="number" name="economyDailyMax" min="0" max="100000" value="<%= premiumSettings?.economyDailyMax ?? 500 %>">
      <label>Work reward — min / max coins (1h cooldown)</label>
      <input type="number" name="economyWorkMin" min="0" max="100000" value="<%= premiumSettings?.economyWorkMin ?? 50 %>">
      <input type="number" name="economyWorkMax" min="0" max="100000" value="<%= premiumSettings?.economyWorkMax ?? 250 %>">
      <label>Currency name</label>
      <input type="text" name="economyCurrencyName" value="<%= premiumSettings?.economyCurrencyName || 'coins' %>" maxlength="32">
      <label>Currency emoji</label>
      <input type="text" name="economyCurrencyEmoji" value="<%= premiumSettings?.economyCurrencyEmoji || '🪙' %>" maxlength="32">
      <br><br><button class="btn" type="submit">Save economy settings</button>
    </form>
    <h2>Shop items <button class="btn ghost" type="button" data-refresh-section="#shop-list">🔄 Refresh</button></h2>
    <div id="shop-list">
    <% if (!shopItems.length) { %><p class="muted">Shop is empty — add an item below (or /shop-add in Discord).</p><% } %>
    <table><tr><th>ID</th><th>Item</th><th>Price</th><th>Role on buy</th><th></th></tr>
    <% shopItems.forEach(i => { %><tr><td>#<%= i.id %></td><td><strong><%= i.name %></strong><% if (i.description) { %><br><span class="muted"><%= i.description %></span><% } %></td><td><%= i.price %></td><td><%= i.role_id ? '@' + (roles.find(r => r.id === i.role_id)?.name || i.role_id) : '—' %></td><td><button class="btn danger" data-remove-shop="<%= i.id %>">Remove</button></td></tr><% }); %></table>
    </div>
    <h2>Add a shop item</h2>
    <form id="add-shop-form">
      <label>Name</label><input type="text" name="name" required maxlength="128">
      <label>Price (coins)</label><input type="number" name="price" min="1" required>
      <label>Description</label><input type="text" name="description" maxlength="512">
      <label>Role granted on buy (optional)</label>
      <select name="roleId"><option value="">— none —</option><% roles.forEach(r => { %><option value="<%= r.id %>"><%= r.name %></option><% }); %></select>
      <br><br><button class="btn" type="submit">Add item</button>
    </form>
    <p id="shop-result" class="muted"></p>
    <% } %>

    <% if (module === 'starboard') { %>
    <h1>Starboard</h1>
    <p class="muted">When a message collects enough reactions of the star emoji, it gets posted here as an embed with a jump link. The count updates as stars arrive; dropping below threshold removes the post. Same settings as /starboard-setup in Discord.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/premium">
      <label>Starboard channel</label>
      <select name="starboardChannelId"><option value="">— off —</option>
        <% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= premiumSettings?.starboardChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %>
      </select>
      <label>Stars needed (threshold)</label>
      <input type="number" name="starboardThreshold" min="1" max="25" value="<%= premiumSettings?.starboardThreshold ?? 3 %>">
      <label>Star emoji</label>
      <input type="text" name="starboardEmoji" value="<%= premiumSettings?.starboardEmoji || '⭐' %>" maxlength="32">
      <br><br><button class="btn" type="submit">Save starboard settings</button>
    </form>
    <% } %>

    <% if (module === 'customcommands') { %>
    <h1>Custom Commands</h1>
    <p class="muted">Trigger words: when a message starts with (or exactly equals) a trigger, the bot replies with the stored response. Triggers can't collide with built-in slash commands, and @everyone/@here are stripped from responses. Same list as /custom-add, /custom-remove, /custom-list in Discord.</p>
    <% if (!customCommands.length) { %><p class="muted">No custom commands yet.</p><% } %>
    <div id="custom-list">
    <table><tr><th>Trigger</th><th>Response</th><th>Uses</th><th></th></tr>
    <% customCommands.forEach(c => { %><tr><td><strong><%= c.trigger_word %></strong></td><td><%= c.response.slice(0, 200) %></td><td><%= c.use_count %></td><td><button class="btn danger" data-remove-custom="<%= c.trigger_word %>">Remove</button></td></tr><% }); %></table>
    </div>
    <h2>Add a custom command</h2>
    <form id="add-custom-form">
      <label>Trigger (single word, lowercase)</label><input type="text" name="trigger" required maxlength="64">
      <label>Response</label><textarea name="response" rows="3" required maxlength="2000"></textarea>
      <br><br><button class="btn" type="submit">Add custom command</button>
    </form>
    <p id="custom-result" class="muted"></p>
    <% } %>

    <% if (module === 'faq') { %>
    <h1>FAQ Auto-Responder</h1>
    <p class="muted">When a message matches a trigger phrase, the bot replies in-channel with the stored answer. <code>contains</code> fires when the phrase appears anywhere in the message; <code>exact</code> only when the whole message equals it. First match wins; FAQ replies never trigger other FAQ/custom responses. Max 50 per server. Same list as /faq-add, /faq-remove, /faq-list in Discord.</p>
    <% if (!faqs.length) { %><p class="muted">No FAQ responses yet.</p><% } %>
    <div id="faq-list">
    <table><tr><th>Trigger</th><th>Match</th><th>Response</th><th>Uses</th><th></th></tr>
    <% faqs.forEach(f => { %><tr><td><strong><%= f.trigger_phrase %></strong></td><td><%= f.match_type %></td><td><%= f.response.slice(0, 200) %></td><td><%= f.use_count %></td><td><button class="btn danger" data-remove-faq="<%= f.id %>">Remove</button></td></tr><% }); %></table>
    </div>
    <h2>Add an FAQ response</h2>
    <form id="add-faq-form">
      <label>Trigger phrase</label><input type="text" name="trigger" required maxlength="100">
      <label>Response</label><textarea name="response" rows="3" required maxlength="2000"></textarea>
      <label>Match type</label>
      <select name="matchType"><option value="contains">contains — phrase appears anywhere</option><option value="exact">exact — whole message equals the phrase</option></select>
      <br><br><button class="btn" type="submit">Add FAQ response</button>
    </form>
    <p id="faq-result" class="muted"></p>
    <% } %>

    <% if (module === 'scheduled') { %>
    <h1>Scheduled Messages</h1>
    <p class="muted">Messages scheduled with /schedule post automatically at their time — stored in MySQL, so they survive restarts. Reminders (/remindme) are DM'd to the user (or posted in-channel if DMs are closed).</p>
    <% if (!scheduledMessages.length) { %><p class="muted">Nothing scheduled.</p><% } %>
    <div id="scheduled-list">
    <table><tr><th>ID</th><th>Channel</th><th>Send at</th><th>Message</th><th></th></tr>
    <% scheduledMessages.forEach(s => { %><tr><td>#<%= s.id %></td><td>#<%= (channels.find(c => c.id === s.channel_id)?.name || s.channel_id) %></td><td><%= s.send_at %></td><td><%= (s.content || (() => { try { return JSON.parse(s.embed_json).title; } catch { return '(embed)'; } })()).slice(0, 120) %></td><td><button class="btn danger" data-cancel-scheduled="<%= s.id %>">Cancel</button></td></tr><% }); %></table>
    </div>
    <p class="muted">Schedule new messages with <code>/schedule</code> in Discord (times like "in 2h", "tomorrow 9am", "2026-11-14 15:00").</p>
    <% } %>

    <% if (module === 'roles') { %>
    <h1>Roles</h1>
    <p class="muted">Auto-role is given to every new member on join. Sticky roles save a member's roles when they leave and restore them if they rejoin. Same settings as /autorole in Discord.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/premium">
      <label>Auto-role (given on join)</label>
      <select name="autoroleId"><option value="">— none —</option>
        <% roles.forEach(r => { %><option value="<%= r.id %>" <%= premiumSettings?.autoroleId === r.id ? 'selected' : '' %>><%= r.name %></option><% }); %>
      </select>
      <label class="toggle"><input type="checkbox" name="stickyRolesEnabled" value="true" <%= premiumSettings?.stickyRolesEnabled ? 'checked' : '' %>><span class="track"></span><span>Sticky roles enabled</span></label>
      <br><br><button class="btn" type="submit">Save role settings</button>
    </form>
    <p class="muted">AFK and polls are Discord-only (see README) — no dashboard tab needed.</p>
    <% } %>

    <% if (module === 'welcome') { %>
    <h1>Welcome &amp; Goodbye</h1>
    <p class="muted">Messages posted when members join or leave. Placeholders: <code>{user}</code> (mention), <code>{username}</code>, <code>{server}</code>, <code>{membercount}</code>. Same settings as /welcome-setup and /goodbye-setup in Discord.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/settings">
      <label class="toggle"><input type="checkbox" name="welcomeEnabled" value="true" <%= settings.welcomeEnabled ? 'checked' : '' %>><span class="track"></span><span>Welcome messages enabled</span></label>
      <label>Welcome channel</label>
      <select name="welcomeChannelId"><option value="">— none —</option>
        <% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= settings.welcomeChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %>
      </select>
      <label>Welcome message template</label>
      <textarea name="welcomeMessage" rows="3" id="welcome-template"><%= settings.welcomeMessage || '' %></textarea>
      <p class="muted">Preview: <code id="welcome-preview"></code></p>
      <label class="toggle"><input type="checkbox" name="goodbyeEnabled" value="true" <%= settings.goodbyeEnabled ? 'checked' : '' %>><span class="track"></span><span>Goodbye messages enabled</span></label>
      <label>Goodbye channel</label>
      <select name="goodbyeChannelId"><option value="">— none —</option>
        <% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= settings.goodbyeChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %>
      </select>
      <label>Goodbye message template</label>
      <textarea name="goodbyeMessage" rows="3" id="goodbye-template"><%= settings.goodbyeMessage || '' %></textarea>
      <p class="muted">Preview: <code id="goodbye-preview"></code></p>
      <br><button class="btn" type="submit">Save welcome &amp; goodbye settings</button>
    </form>
    <% } %>

    <% if (module === 'automod') { %>
    <h1>Automod</h1>
    <p class="muted">Spam detection, banned words, and link/invite blocking. Exempt roles and channels bypass every check; admins are always exempt. The configured action (delete / warn / timeout) applies to every Automod hit. Same settings as /automod-setup in Discord.</p>
    <p id="automod-status"><% if (!automodSettings || !automodSettings.enabled) { %>Automod is currently <strong>❌ disabled</strong> in this server.<% } else { %>Automod is currently <strong>✅ enabled</strong> in this server.<% } %></p>
    <form id="automod-form">
      <label class="toggle"><input type="checkbox" name="enabled" value="true" <%= automodSettings?.enabled ? 'checked' : '' %>><span class="track"></span><span>Automod enabled</span></label>
      <label>Spam: max messages</label>
      <input type="number" name="spamMaxMessages" min="2" max="50" value="<%= automodSettings?.spam_max_messages ?? 5 %>">
      <label>Spam: window (seconds)</label>
      <input type="number" name="spamWindowSeconds" min="2" max="120" value="<%= automodSettings?.spam_window_seconds ?? 5 %>">
      <label>Action on a hit</label>
      <select name="spamAction">
        <option value="delete" <%= automodSettings?.spam_action === 'delete' ? 'selected' : '' %>>Delete only</option>
        <option value="warn" <%= automodSettings?.spam_action === 'warn' ? 'selected' : '' %>>Warn only</option>
        <option value="timeout" <%= automodSettings?.spam_action === 'timeout' ? 'selected' : '' %>>Timeout only</option>
        <option value="delete_warn" <%= !automodSettings || automodSettings?.spam_action === 'delete_warn' ? 'selected' : '' %>>Delete + warn</option>
        <option value="delete_timeout" <%= automodSettings?.spam_action === 'delete_timeout' ? 'selected' : '' %>>Delete + timeout</option>
      </select>
      <label>Timeout length (minutes, when the action includes a timeout)</label>
      <input type="number" name="spamTimeoutMinutes" min="1" max="40320" value="<%= automodSettings?.spam_timeout_minutes ?? 10 %>">
      <label class="toggle"><input type="checkbox" name="blockLinks" value="true" <%= automodSettings?.block_links ? 'checked' : '' %>><span class="track"></span><span>Block links</span></label>
      <label class="toggle"><input type="checkbox" name="blockInvites" value="true" <%= automodSettings?.block_invites !== 0 ? 'checked' : '' %>><span class="track"></span><span>Block Discord invite links</span></label>
      <label>Log channel</label>
      <select name="logChannelId"><option value="">— none —</option>
        <% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= automodSettings?.log_channel_id === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %>
      </select>
      <label>Banned words (one per line)</label>
      <textarea name="bannedWords" rows="4"><% try { (JSON.parse(automodSettings?.banned_words || '[]') || []).forEach(w => { %><%= w %>
<% }); } catch {} %></textarea>
      <label>Exempt roles (hold Ctrl/Cmd to pick several)</label>
      <select name="exemptRoles" multiple size="5"><% roles.forEach(r => { %><option value="<%= r.id %>" <%= (JSON.parse(automodSettings?.exempt_roles || '[]') || []).includes(r.id) ? 'selected' : '' %>><%= r.name %></option><% }); %></select>
      <label>Exempt channels (hold Ctrl/Cmd to pick several)</label>
      <select name="exemptChannels" multiple size="5"><% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= (JSON.parse(automodSettings?.exempt_channels || '[]') || []).includes(c.id) ? 'selected' : '' %>>#<%= c.name %></option><% }); %></select>
      <br><br><button class="btn" type="submit">Save Automod settings</button>
    </form>
    <p id="automod-result" class="muted"></p>
    <h2>Recent Automod actions <button class="btn ghost" type="button" data-refresh-section="#automod-actions-list">🔄 Refresh</button></h2>
    <div id="automod-actions-list">
    <% if (!automodActions.length) { %><p class="muted">No Automod actions logged yet.</p><% } %>
    <table><tr><th>When</th><th>User</th><th>Action</th><th>Reason</th><th>Message</th></tr>
    <% automodActions.forEach(a => { %><tr><td><%= a.created_at %></td><td>&lt;@<%= a.user_id %>&gt;</td><td><%= a.action %></td><td><%= a.reason %></td><td><%= (a.message_excerpt || '').slice(0, 80) %></td></tr><% }); %></table>
    </div>
    <% } %>

    <% if (module === 'suggestions') { %>
    <h1>Suggestions</h1>
    <p class="muted">Members submit ideas with /suggest; they land in the suggestions channel with 👍/👎 voting (one vote per user, changeable). Staff approve, deny, or mark implemented — the suggester gets a DM.</p>
    <form method="post" action="/api/guilds/<%= guild.id %>/settings">
      <label>Suggestions channel</label>
      <select name="suggestionChannelId"><option value="">— none —</option>
        <% channels.filter(c => c.type === 0).forEach(c => { %><option value="<%= c.id %>" <%= settings.suggestionChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }); %>
      </select>
      <br><br><button class="btn" type="submit">Save suggestions channel</button>
    </form>
    <h2>All suggestions <button class="btn ghost" type="button" data-refresh-section="#suggestions-list">🔄 Refresh</button></h2>
    <p>
      <button class="btn ghost" data-sugg-filter="pending">Pending</button>
      <button class="btn ghost" data-sugg-filter="approved">Approved</button>
      <button class="btn ghost" data-sugg-filter="denied">Denied</button>
      <button class="btn ghost" data-sugg-filter="implemented">Implemented</button>
      <button class="btn ghost" data-sugg-filter="">All</button>
    </p>
    <div id="suggestions-list">
    <% if (!suggestions.length) { %><p class="muted">No suggestions yet.</p><% } %>
    <% suggestions.forEach(s => { %>
      <div class="card" style="text-align:left;margin-bottom:12px">
        <strong>#<%= s.id %> — <%= s.title %></strong> · <code>&lt;@<%= s.user_id %>&gt;</code> · <%= s.status %> · 👍 <%= s.votes_up %> · 👎 <%= s.votes_down %><br>
        <p><%= s.text %></p>
        <% if (s.status === 'pending') { %>
          <button class="btn green" data-sugg-review="<%= s.id %>" data-sugg-decision="approved">✅ Approve</button>
          <button class="btn danger" data-sugg-review="<%= s.id %>" data-sugg-decision="denied">❌ Deny</button>
          <button class="btn" data-sugg-review="<%= s.id %>" data-sugg-decision="implemented">🚀 Mark implemented</button>
        <% } %>
      </div>
    <% }); %>
    </div>
    <% } %>
  </section>
</div>

<script>window.ACEBOT_PAGE = { page: 'settings', guildId: '<%= guild.id %>' };</script>
<script src="/js/settings.js" defer></script>

<%- include('partials/footer') %>
